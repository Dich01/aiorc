  "html": {
    "Use a token with a project ID (<code>AIORC_PROJECT_ID</code> + <code>AIORC_TOKEN</code>) to run any project you own or were invited to, and any public project. Runs are recorded under your name. A token is shown only once.": "Usa un token con un ID de proyecto (<code>AIORC_PROJECT_ID</code> + <code>AIORC_TOKEN</code>) para ejecutar cualquier proyecto que sea tuyo o al que te hayan invitado, y cualquier proyecto público. Las ejecuciones quedan registradas a tu nombre. Un token se muestra una sola vez.",
    "This page expects a <code>?nick=user</code> parameter in the URL.": "Esta página espera un parámetro <code>?nick=user</code> en la URL."
  },
  "patterns": [
    { "re": "^Member since (January|February|March|April|May|June|July|August|September|October|November|December) (\\d{1,2}), (\\d{4})$", "es": "Miembro desde el $2 de $1 de $3" },
    { "re": "^· Last activity (January|February|March|April|May|June|July|August|September|October|November|December) (\\d{1,2}), (\\d{4})$", "es": "· Última actividad: $2 de $1 de $3" },
    { "re": "^(January|February|March|April|May|June|July|August|September|October|November|December) (\\d{1,2}), (\\d{4})$", "es": "$2 de $1 de $3" },
    { "re": "^· ★ (\\d+) received$", "es": "· ★ $1 recibidas" },
    { "re": "^(\\d+) received$", "es": "$1 recibidos" },
    { "re": "^Public projects \\((\\d+)\\)$", "es": "Proyectos públicos ($1)" },
    { "re": "^Public agents \\((\\d+)\\)$", "es": "Agentes públicos ($1)" },
    { "re": "^Public skills \\((\\d+)\\)$", "es": "Skills públicas ($1)" }
  ]
