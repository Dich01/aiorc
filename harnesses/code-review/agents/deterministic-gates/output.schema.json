{
  "type": "object",
  "required": ["gates", "secrets_found"],
  "properties": {
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["tool", "version", "exit_code", "report_sha256"],
        "properties": {
          "tool": { "type": "string", "minLength": 1, "maxLength": 80 },
          "version": { "type": "string", "maxLength": 80 },
          "exit_code": { "type": "integer" },
          "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "secrets_found": { "type": "boolean" }
  },
  "additionalProperties": false
}
