{
  "type": "object",
  "required": ["id", "severity", "category", "file", "line_start", "line_end", "title", "evidence", "suggestion", "control_refs", "confidence"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "category": { "enum": ["security", "correctness", "ticket-compliance", "secrets", "tests", "other"] },
    "file": { "type": "string", "minLength": 1, "maxLength": 500 },
    "line_start": { "type": "integer", "minimum": 1 },
    "line_end": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "evidence": { "type": "string", "maxLength": 4000 },
    "suggestion": { "type": "string", "maxLength": 4000 },
    "control_refs": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 20 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
