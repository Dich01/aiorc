{
  "type": "object",
  "required": ["repo", "base_sha", "head_sha", "diff_sha256", "changed_files"],
  "properties": {
    "repo": { "type": "string", "minLength": 1, "maxLength": 200 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pr_number": { "type": "integer", "minimum": 1 },
    "diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 2000 },
    "ticket": { "type": "string", "maxLength": 200 },
    "request": { "type": "string", "maxLength": 2000 }
  },
  "additionalProperties": false
}
