{
  "type": "object",
  "required": ["base_sha", "head_sha", "changed_files", "diff_sha256", "notes"],
  "properties": {
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["path", "status", "additions", "deletions"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "status": { "enum": ["added", "modified", "deleted", "renamed"] },
          "additions": { "type": "integer", "minimum": 0 },
          "deletions": { "type": "integer", "minimum": 0 },
          "uncommitted": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "diff_sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "additionalProperties": false
}
