{
  "type": "object",
  "required": [
    "type",
    "subject",
    "body",
    "breaking",
    "message"
  ],
  "properties": {
    "type": {
      "enum": [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z0-9._/-]{0,40}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "not": {
        "pattern": "[Cc]o-[Aa]uthored-[Bb]y|[Gg]enerated with|noreply@anthropic\\.com|[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]"
      }
    },
    "body": {
      "type": "string",
      "maxLength": 4000,
      "not": {
        "pattern": "[Cc]o-[Aa]uthored-[Bb]y|[Gg]enerated with|noreply@anthropic\\.com|[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]"
      }
    },
    "breaking": {
      "type": "boolean"
    },
    "split_suggestion": {
      "type": "string",
      "maxLength": 1000
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "not": {
        "pattern": "[Cc]o-[Aa]uthored-[Bb]y|[Gg]enerated with|noreply@anthropic\\.com|[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]"
      }
    }
  },
  "additionalProperties": false
}
