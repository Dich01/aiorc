        "edges": [
          {
            "id": "e-start",
            "from": "start",
            "to": "task"
          },
          {
            "id": "e-task-no-changes",
            "from": "task",
            "to": "no-changes",
            "when": {
              "path": "status",
              "op": "eq",
              "value": "no-changes"
            }
          },
          {
            "id": "e-task-missing",
            "from": "task",
            "to": "needs-task",
            "when": {
              "path": "status",
              "op": "eq",
              "value": "missing-task"
            }
          },
          {
            "id": "e-task-setup",
            "from": "task",
            "to": "setup-error",
            "when": {
              "path": "status",
              "op": "eq",
              "value": "setup-error"
            }
          },
          {
            "id": "e-task-ok",
            "from": "task",
            "to": "risk",
            "default": true
          },
          {
            "id": "e-risk-split",
            "from": "risk",
            "to": "split-change",
            "when": {
              "path": "level",
              "op": "eq",
              "value": "split"
            }
          },
          {
            "id": "e-risk-none",
            "from": "risk",
            "to": "no-changes",
            "when": {
              "path": "level",
              "op": "eq",
              "value": "none"
            }
          },
          {
            "id": "e-risk-ok",
            "from": "risk",
            "to": "checks",
            "default": true
          },
          {
            "id": "e-checks-weakened",
            "from": "checks",
            "to": "needs-human",
            "when": {
              "path": "weakening.weakened",
              "op": "eq",
              "value": true
            },
            "priority": 1
          },
          {
            "id": "e-checks-unconfigured",
            "from": "checks",
            "to": "needs-profile",
            "when": {
              "path": "checks.configured",
              "op": "eq",
              "value": false
            },
            "priority": 2
          },
          {
            "id": "e-checks-failed",
            "from": "checks",
            "to": "fix-checks",
            "when": {
              "path": "checks.passed",
              "op": "eq",
              "value": false
            },
            "priority": 3
          },
          {
            "id": "e-checks-ok",
            "from": "checks",
            "to": "prepare",
            "default": true
          },
          {
            "id": "e-fix-checks-stuck",
            "from": "fix-checks",
            "to": "fixer-stuck",
            "when": {
              "path": "stuck",
              "op": "eq",
              "value": true
            }
          },
          {
            "id": "e-fix-checks-again",
            "from": "fix-checks",
            "to": "checks",
            "default": true
          },
          {
            "id": "e-prepare-full",
            "from": "prepare",
            "to": "fork-full",
            "when": {
              "path": "depth",
              "op": "eq",
              "value": "full"
            },
            "priority": 1
          },
          {
            "id": "e-prepare-none",
            "from": "prepare",
            "to": "explain",
            "when": {
              "path": "depth",
              "op": "eq",
              "value": "none"
            },
            "priority": 2
          },
          {
            "id": "e-prepare-min",
            "from": "prepare",
            "to": "fork-min",
            "default": true
          },
          {
            "id": "e-fork-min-correctness",
            "from": "fork-min",
            "to": "min-correctness"
          },
          {
            "id": "e-join-min-correctness",
            "from": "min-correctness",
            "to": "verifier"
          },
          {
            "id": "e-fork-min-intent",
            "from": "fork-min",
            "to": "min-intent"
          },
          {
            "id": "e-join-min-intent",
            "from": "min-intent",
            "to": "verifier"
          },
          {
            "id": "e-fork-full-correctness",
            "from": "fork-full",
            "to": "full-correctness"
          },
          {
            "id": "e-join-full-correctness",
            "from": "full-correctness",
            "to": "verifier"
          },
          {
            "id": "e-fork-full-security",
            "from": "fork-full",
            "to": "full-security"
          },
          {
            "id": "e-join-full-security",
            "from": "full-security",
            "to": "verifier"
          },
          {
            "id": "e-fork-full-intent",
            "from": "fork-full",
            "to": "full-intent"
          },
          {
            "id": "e-join-full-intent",
            "from": "full-intent",
            "to": "verifier"
          },
          {
            "id": "e-fork-full-blind",
            "from": "fork-full",
