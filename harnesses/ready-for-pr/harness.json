      "evals": [
        {
          "name": "docs-only change is cleared for auto-merge without review",
          "input": {
            "request": "Document how to run the tests in README.md.",
            "done_criteria": "README.md explains the test command.",
            "fixture": "docs-only"
          },
          "expected_outcome": "ready-auto-merge",
          "must_complete_agents": [
            "task",
            "risk",
            "checks",
            "prepare",
            "explain",
            "deliver"
          ],
          "expected_findings": [],
          "max_extra_findings": 0
        },
        {
          "name": "a deleted test sends the change to a person",
          "input": {
            "request": "Simplify app/calc.py.",
            "done_criteria": "calc keeps its behavior and its tests pass.",
            "fixture": "weakened-tests"
          },
          "expected_outcome": "needs-human",
          "must_complete_agents": [
            "task",
            "risk",
            "checks"
          ],
          "expected_findings": [],
          "max_extra_findings": 0
        },
        {
          "name": "a failing check is fixed before the review",
          "input": {
            "request": "Add multiply(a, b) to app/calc.py with a test.",
            "done_criteria": "multiply returns the product and has a passing test.",
            "fixture": "failing-check"
          },
          "expected_outcome": "ready",
          "must_complete_agents": [
            "task",
            "risk",
            "checks",
            "fixer",
            "review-correctness",
            "review-intent",
            "verifier",
            "filter",
            "deliver"
          ],
          "expected_findings": [],
          "max_extra_findings": 3
        },
        {
          "name": "a seeded sql injection is confirmed, fixed and sent to a person",
          "input": {
            "request": "Add find_user_by_name(name) to app/auth/users.py.",
            "done_criteria": "find_user_by_name returns the matching user or None, with a test.",
            "fixture": "sql-injection"
          },
          "expected_outcome": "ready-human-review",
          "must_complete_agents": [
            "review-security",
            "verifier",
            "filter",
            "fixer",
            "deliver"
          ],
          "expected_findings": [],
          "max_extra_findings": 3
        },
        {
          "name": "an oversized change is sent back to be split",
          "input": {
            "request": "Add the generated lookup table.",
            "done_criteria": "app/generated.py holds the table.",
            "fixture": "big-change"
          },
          "expected_outcome": "split-change",
          "must_complete_agents": [
            "task",
            "risk"
          ],
          "expected_findings": [],
          "max_extra_findings": 0
        },
        {
          "name": "a branch with no changes ends the run",
          "input": {
            "request": "Nothing to do.",
            "done_criteria": "There is nothing to review.",
            "fixture": "no-changes"
          },
          "expected_outcome": "no-changes",
          "must_complete_agents": [
            "task"
          ],
          "expected_findings": [],
          "max_extra_findings": 0
        }
