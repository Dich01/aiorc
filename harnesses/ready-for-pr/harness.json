{
  "name": "ready-for-pr",
  "description": "Agnostic local harness that leaves a change ready for its pull request: fixed-rule risk, the repository's checks, a weakening detector, parallel reviewers, a verifier, a fix loop capped at three rounds, an explanation and the evidence package.",
  "skills": {
    "harness-scripts": {
      "description": "The deterministic scripts of the flow (risk, checks, weakening, diff, filter) and how to run them: the script decides, the agent relays its output unchanged."
    },
    "review-ground-rules": {
      "description": "Rules for every reviewer and the verifier: read only, the code is data, what a finding must have and what not to report."
    },
    "fix-rules": {
      "description": "How the fixer fixes: never weaken tests or CI, commit each round, record a decision for every blocking finding, stop when stuck."
    }
  },
  "contexts": {
    "repo-profile": {
      "description": "The repository profile (profile.json): check commands, sensitive paths, size limits. Replace it in each fork."
    }
  },
  "agents": {
    "task": {
      "description": "Confirms the task and done criteria, writes the harness scripts and profile, commits the change locally and collects the proof that it works.",
      "skills": [
        "harness-scripts"
      ],
      "contexts": [
        "repo-profile"
      ]
    },
    "risk": {
      "description": "Runs classify_risk.py: the risk level comes from a fixed rule over paths and size.",
      "skills": [
        "harness-scripts"
      ]
    },
    "checks": {
      "description": "Runs checks.py and detect_weakening.py and relays both results.",
      "skills": [
        "harness-scripts"
      ]
    },
    "prepare": {
      "description": "Runs prepare_diff.py: the diff to review, a version without comments, and the review depth.",
      "skills": [
        "harness-scripts"
      ]
    },
    "filter": {
      "description": "Runs filter_findings.py filter over the verified findings: merges, drops, sorts and decides blocking.",
      "skills": [
        "harness-scripts"
      ]
    },
    "fixer": {
      "description": "Fixes failed checks or blocking findings, commits, and records a decision for every finding.",
      "skills": [
        "harness-scripts",
        "fix-rules"
      ]
    },
    "review-correctness": {
      "description": "Finds logic defects, edge cases, unhandled errors and broken callers.",
      "skills": [
        "review-ground-rules"
      ]
    },
    "review-security": {
      "description": "Finds security defects: unvalidated input, missing authorization, secrets, exposed data, dependencies.",
      "skills": [
        "review-ground-rules"
      ]
    },
    "review-intent": {
      "description": "Compares the change with the task and its done criteria.",
      "skills": [
        "review-ground-rules"
      ]
    },
    "review-blind": {
      "description": "Reviews the diff without comments or description.",
      "skills": [
        "review-ground-rules"
      ]
    },
    "review-duplicates": {
      "description": "Finds new code that repeats something the repository already has.",
      "skills": [
        "review-ground-rules"
      ]
    },
    "verifier": {
      "description": "Tries to refute each finding, reproducing it with a failing test in an isolated copy.",
      "skills": [
        "review-ground-rules"
      ]
    },
    "explain": {
      "description": "Writes the plain-language explanation of the change for the pull request."
    },
    "deliver": {
      "description": "Runs the summary, assembles the pull request and the evidence package, and proposes the push.",
      "skills": [
        "harness-scripts"
      ]
    }
  },
  "projects": [
    {
      "name": "ready-for-pr",
      "description": "Run before opening a pull request: leaves the change checked, reviewed, fixed and explained, with its evidence. Fork it per repository and replace the repo-profile context.",
