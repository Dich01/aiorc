              "path": "stuck",
              "op": "eq",
              "value": true
            }
          },
          {
            "id": "e-fix-findings-again",
            "from": "fix-findings",
            "to": "checks",
            "default": true
          },
          {
            "id": "e-explained",
            "from": "explain",
            "to": "deliver"
          },
