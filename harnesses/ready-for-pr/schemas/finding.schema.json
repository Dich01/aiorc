{
  "type": "object",
  "required": ["id", "severity", "category", "file", "line_start", "line_end", "title", "failure_scenario", "evidence", "suggestion", "reviewer", "verification"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "category": { "enum": ["correctness", "security", "secrets", "intent", "duplication", "tests", "other"] },
    "file": { "type": "string", "minLength": 1, "maxLength": 500 },
    "line_start": { "type": "integer", "minimum": 1 },
    "line_end": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "failure_scenario": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidence": { "type": "string", "maxLength": 4000 },
    "suggestion": { "type": "string", "maxLength": 4000 },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification": { "enum": ["unverified", "confirmed", "plausible", "discarded"] },
    "verification_note": { "type": "string", "maxLength": 2000 },
    "evidence_test": { "type": "string", "maxLength": 8000 }
  },
  "additionalProperties": false
}
